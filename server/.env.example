# ============================================
# GlobeTrotter Backend Environment Variables
# Copy this file to ".env" and fill in real values
# ============================================

# --- Flask ---
FLASK_ENV=development
SECRET_KEY=change-this-secret-key
DEBUG=True

# --- Database (PostgreSQL) ---
# Example: postgresql://username:password@localhost:5432/globetrotter
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/globetrotter

# --- JWT ---
JWT_SECRET_KEY=change-this-jwt-secret-key
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# --- Cloudinary (image uploads) ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- Brevo (transactional emails, API based) ---
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=no-reply@globetrotter.com
BREVO_SENDER_NAME=GlobeTrotter

# --- Frontend ---
FRONTEND_URL=http://localhost:5173
