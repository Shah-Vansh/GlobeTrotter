# ==============================
# GlobeTrotter MCP Chatbot
# ==============================

# Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Existing GlobeTrotter backend
GLOBETROTTER_API_URL=http://localhost:5000

# MCP
MCP_SERVER_NAME=globetrotter-mcp

# Chatbot server
CHATBOT_HOST=127.0.0.1
CHATBOT_PORT=8001

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
